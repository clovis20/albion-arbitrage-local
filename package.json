{
  "name": "novo-site-precos",
  "version": "1.0.0",
  "description": "Albion Online Arbitrage Calculator",
  "main": "main.js",
  "scripts": {
    "dev": "nodemon src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "dev:full": "concurrently \"npm run dev\" \"npm run frontend:dev\"",
    "electron:dev": "concurrently \"npm run dev\" \"npm run frontend:build -- --watch\" \"wait-on frontend/dist/index.html && electron .\"",
    "electron:pack": "npm run build && npm run frontend:build && electron-builder --dir",
    "electron:dist": "npm run build && npm run frontend:build && electron-builder"
  },
  "keywords": [
    "albion",
    "arbitrage",
    "market",
    "calculator"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "nats": "^2.19.0",
    "node-cron": "^3.0.3",
    "pg": "^8.11.3",
    "socket.io": "^4.7.2",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "build": {
    "appId": "com.albion.arbitrage",
    "productName": "Albion Arbitrage",
    "directories": {
      "buildResources": "build",
      "output": "dist_electron"
    },
    "files": [
      "main.js",
      "dist/**/*",
      "frontend/dist/**/*",
      "src/**/*",
      "albion_arbitrage.db",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "albion_arbitrage.db",
        "to": "albion_arbitrage.db"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.0",
    "@types/node-cron": "^3.0.7",
    "@types/pg": "^8.10.7",
    "@types/sqlite3": "^5.1.0",
    "concurrently": "^8.2.2",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "wait-on": "^8.0.3"
  }
}
